// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Fish {
  id        Int        @id @default(autoincrement())
  acousticId  String     @unique @default("") // Renamed from deviceId
  fishCode      String?    // Renamed from code (Business ID)
  name      String
  type      String     @default("default")
  ip        String?
  port      Int?
  rtspUrl   String?
  rtsp2     String?
  starlinkRtspMono   String?
  starlinkRtspStereo String?
  // 通信参数：卫通与微波
  satcomIp       String?
  satcomPort1    Int?
  satcomPort2    Int?
  serialPortPath    String? // Renamed from microwaveIp
  serialBaudRate  Int? // Renamed from microwavePort
  // 声通定位基准
  acousticLon    Float?
  acousticLat    Float?

  // Display & Navigation
  showOnMap      Boolean    @default(true)
  initialLon     Float?
  initialLat     Float?

  alerts    Alert[]
  history   History[]
  videos    Video[]

  status    FishStatus @default(running)
  // 控制命令（可选）
  ascendCommand   String?
  descendCommand  String?
  forwardCommand  String?
  leftCommand     String?
  rightCommand    String?
  upCommand       String?
  downCommand     String?
  surfCommand     String?
  manualCommand   String?
  returnCommand   String?
  navigateCommand String?
  lightOnCommand  String?
  lightOffCommand String?
  wifiCommand     String?
  wifiOffCommand  String?
  description     String?
  // 轨迹（JSON 数组：{ lon, lat, alt|null, depth|null }[]）
  track Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("fish")
}

model Alert {
  id          Int       @id @default(autoincrement())
  title       String
  message     String?
  level       String?
  type        String?
  source      String?
  imgFile     String?
  lat         Float?
  lon         Float?
  fishId      Int?
  fish        Fish?     @relation(fields: [fishId], references: [id], onDelete: SetNull)
  status      AlertStatus @default(active)
  createdAt   DateTime   @default(now())
  // 新增：是否来自于 socket 客户端数据
  fromSocket  Boolean    @default(true)
  // 新增：图片的 base64 内容（后续保存）
  imageBase64 String?


  @@map("alerts")
}

model History {
  id             Int       @id @default(autoincrement())
  fishId         Int?
  fish           Fish?     @relation(fields: [fishId], references: [id], onDelete: SetNull)
  lon            Float?
  lat            Float?
  depth          Float?
  height         Float?
  battery        Int?
  signalStrength Int?
  time           DateTime
  content        String?
  rawLine        String?   @map("raw_line")
  rollDeg        Float?
  pitchDeg       Float?
  yawDeg         Float?
  axMs2          Float?
  ayMs2          Float?
  azMs2          Float?
  createdAt      DateTime  @default(now())

  @@map("history")
}

model Video {
  id         Int       @id @default(autoincrement())
  fishId     Int?
  fish       Fish?     @relation(fields: [fishId], references: [id], onDelete: SetNull)
  path       String
  name       String
  size       Int?
  camera     VideoCameraType @default(unknown)
  recordedAt DateTime?
  endedAt    DateTime?
  createdAt  DateTime @default(now())

  @@map("videos")
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  time      DateTime @default(now())
  content   String
  type      String   // 'send' | 'receive'

  @@map("system_logs")
}

enum VideoCameraType {
  mono
  stereo
  unknown
}

enum FishStatus {
  running
  stopped
}



enum AlertStatus {
  active
  resolved
  acknowledged
}

model ImageFrame {
  id        Int      @id @default(autoincrement())
  imageId   String
  current   Int
  total     Int
  data      String   // Base64 chunk
  crc       String?
  filename  String?
  createdAt DateTime @default(now())

  @@map("image_frames")
}
